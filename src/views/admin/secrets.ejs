<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>
<body>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div>
          <div class="page-title">Secrets Kubernetes</div>
          <div class="page-subtitle">Noms des secrets uniquement — les valeurs ne sont jamais exposées</div>
        </div>
      </div>

      <div class="flash flash-info mb-4" style="display:flex;align-items:center;gap:8px;">
        🔒 Les valeurs des secrets sont gérées exclusivement via <code>kubectl</code> ou le CI/CD GitLab.
        Aucune valeur n'est accessible depuis cette interface, quel que soit le rôle.
      </div>

      <div class="card">
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Nom du secret</th><th>Namespace</th><th>Type</th><th>Clés</th></tr>
            </thead>
            <tbody>
              <% secrets.forEach(secret => { %>
              <tr>
                <td class="font-mono"><strong><%= secret.name %></strong></td>
                <td><span class="badge badge-gray"><%= secret.namespace %></span></td>
                <td><span class="badge badge-info"><%= secret.type %></span></td>
                <td>
                  <% secret.keys.forEach(key => { %>
                    <span class="badge badge-gray" style="margin-right:4px;font-family:monospace;"><%= key %></span>
                  <% }) %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>
</body>
</html>
