<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>
<body>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div>
          <div class="page-title">Gestion des utilisateurs</div>
          <div class="page-subtitle">Administration des comptes et des rôles CNP</div>
        </div>
      </div>

      <%# ── Pending approvals section (live via SSE) ── %>
      <div id="pending-section" class="card" style="margin-bottom:24px;border-color:rgba(234,179,8,0.3);display:none;">
        <div class="card-header" style="background:rgba(234,179,8,0.06);">
          <span class="card-title" style="display:flex;align-items:center;gap:10px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            Comptes en attente d'approbation
          </span>
          <span id="pending-badge" class="badge badge-warning">0</span>
        </div>
        <div id="pending-list" class="table-container">
          <table>
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Méthode</th>
                <th>Demande le</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="pending-tbody"></tbody>
          </table>
        </div>
      </div>

      <%# ── All users table ── %>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Tous les utilisateurs</span>
          <span class="badge badge-gray"><%= users.length %> compte(s)</span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Email</th>
                <th>Rôle CNP</th>
                <th>Statut</th>
                <th>Créé le</th>
                <% if (can('users:modify-role') || can('users:approve')) { %>
                <th>Actions</th>
                <% } %>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
              <tr id="user-row-<%= u.id %>">
                <td>
                  <div class="flex-center">
                    <% if (u.avatarUrl) { %>
                      <img src="<%= u.avatarUrl %>" width="28" height="28" style="border-radius:50%;object-fit:cover;">
                    <% } else { %>
                      <div style="width:28px;height:28px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;flex-shrink:0;">
                        <%= u.username.charAt(0).toUpperCase() %>
                      </div>
                    <% } %>
                    <strong><%= u.username %></strong>
                    <% if (u.id === user.id) { %><span class="badge badge-gray">vous</span><% } %>
                    <% if (u.githubId && !u.gitlabId) { %>
                      <span class="badge badge-gray" style="font-size:10px;">GitHub</span>
                    <% } else if (u.gitlabId) { %>
                      <span class="badge badge-gray" style="font-size:10px;">GitLab</span>
                    <% } %>
                  </div>
                </td>
                <td class="text-muted"><%= u.email || '—' %></td>
                <td>
                  <span class="badge role-badge-<%= u.role %>"><%= u.role %></span>
                </td>
                <td>
                  <% if (!u.approved) { %>
                    <span class="badge badge-warning">En attente</span>
                  <% } else if (u.active) { %>
                    <span class="badge badge-success">Actif</span>
                  <% } else { %>
                    <span class="badge badge-danger">Désactivé</span>
                  <% } %>
                </td>
                <td class="text-muted"><%= new Date(u.createdAt).toLocaleDateString('fr-FR') %></td>
                <% if (can('users:modify-role') || can('users:approve')) { %>
                <td>
                  <% if (u.id !== user.id) { %>
                  <div class="actions-cell">
                    <% if (!u.approved && can('users:approve')) { %>
                      <button
                        class="btn btn-sm btn-success approve-btn"
                        data-id="<%= u.id %>"
                        data-username="<%= u.username %>"
                      >Approuver</button>
                    <% } %>
                    <% if (can('users:modify-role')) { %>
                    <form action="/admin/users/<%= u.id %>/role" method="POST" class="flex-center">
                      <select name="role" style="padding:4px 8px;font-size:12px;width:auto;">
                        <option value="manager" <%= u.role === 'manager' ? 'selected' : '' %>>manager</option>
                        <option value="devops"  <%= u.role === 'devops'  ? 'selected' : '' %>>devops</option>
                        <option value="dev"     <%= u.role === 'dev'     ? 'selected' : '' %>>dev</option>
                      </select>
                      <button type="submit" class="btn btn-secondary btn-sm">Appliquer</button>
                    </form>
                    <button
                      type="button"
                      class="btn btn-sm btn-danger"
                      onclick="openRemoveModal('<%= u.id %>', '<%= u.username %>')"
                    >Supprimer l'utilisateur</button>
                    <% } %>
                  </div>
                  <% } else { %>
                    <span class="text-muted" style="font-size:12px;">—</span>
                  <% } %>
                </td>
                <% } %>
              </tr>
              <% }) %>
              <% if (users.length === 0) { %>
              <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:32px;">Aucun utilisateur</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Remove user confirmation modal -->
<div id="removeUserModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:var(--surface);width:440px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
    <h3 style="margin:0 0 8px;color:var(--danger,#ef4444);">Supprimer l'utilisateur</h3>
    <p id="removeUserModalText" style="color:var(--text-muted);margin-bottom:16px;font-size:14px;"></p>
    <div class="flash flash-error" style="margin-bottom:16px;font-size:13px;">
      Cette action est irréversible. Le compte sera définitivement supprimé.
    </div>
    <form id="removeUserForm" method="POST">
      <div style="display:flex;gap:10px;">
        <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('removeUserModal').style.display='none'">Annuler</button>
      </div>
    </form>
  </div>
</div>

<style>
  .btn-success { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); }
  .btn-success:hover { background: rgba(34,197,94,0.25); }
  .badge-warning { background: rgba(234,179,8,0.15); color: #eab308; border: 1px solid rgba(234,179,8,0.3); }
  #pending-section { transition: all 0.3s ease; }
  .approve-inline-btn { background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3); padding: 5px 14px; border-radius: 6px; font-size: 12px; cursor: pointer; font-weight: 600; transition: background 0.2s; }
  .approve-inline-btn:hover { background: rgba(34,197,94,0.3); }
  .approve-inline-btn:disabled { opacity: 0.5; cursor: not-allowed; }
</style>

<script>
  // ── SSE live pending updates ──
  const pendingSection = document.getElementById('pending-section');
  const pendingBadge   = document.getElementById('pending-badge');
  const pendingTbody   = document.getElementById('pending-tbody');

  function renderPendingRow(u) {
    const initial = (u.username || '?')[0].toUpperCase();
    const avatar = u.avatarUrl
      ? `<img src="${u.avatarUrl}" width="28" height="28" style="border-radius:50%;object-fit:cover;">`
      : `<div style="width:28px;height:28px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;flex-shrink:0;">${initial}</div>`;
    const provider = u.githubId && !u.gitlabId ? 'GitHub' : u.gitlabId ? 'GitLab' : 'Local';
    const date = new Date(u.createdAt).toLocaleDateString('fr-FR');
    return `<tr id="pending-row-${u.id}">
      <td><div class="flex-center">${avatar}<strong>${u.username}</strong></div></td>
      <td class="text-muted">${u.email || '—'}</td>
      <td><span class="badge badge-gray" style="font-size:10px;">${provider}</span></td>
      <td class="text-muted">${date}</td>
      <td>
        <button class="approve-inline-btn" onclick="approveUser('${u.id}', '${u.username}', this)">
          ✓ Approuver
        </button>
      </td>
    </tr>`;
  }

  function applyPendingList(list) {
    pendingBadge.textContent = list.length;
    if (list.length === 0) {
      pendingSection.style.display = 'none';
    } else {
      pendingSection.style.display = '';
      pendingTbody.innerHTML = list.map(renderPendingRow).join('');
    }

    // Sync status badges in the main table
    list.forEach(u => {
      const row = document.getElementById('user-row-' + u.id);
      if (!row) return;
      const statusCell = row.querySelector('td:nth-child(4)');
      if (statusCell) statusCell.innerHTML = '<span class="badge badge-warning">En attente</span>';
    });
  }

  async function approveUser(id, username, btn) {
    btn.disabled = true;
    btn.textContent = '…';
    try {
      const res = await fetch(`/admin/users/${id}/approve`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      if (!res.ok) throw new Error('Erreur serveur');
      // SSE will update the list; also update the main table row immediately
      const row = document.getElementById('user-row-' + id);
      if (row) {
        const statusCell = row.querySelector('td:nth-child(4)');
        if (statusCell) statusCell.innerHTML = '<span class="badge badge-success">Actif</span>';
        const actionsCell = row.querySelector('.approve-btn');
        if (actionsCell) actionsCell.remove();
      }
      document.getElementById('pending-row-' + id)?.remove();
      const remaining = pendingTbody.querySelectorAll('tr').length;
      pendingBadge.textContent = remaining;
      if (remaining === 0) pendingSection.style.display = 'none';
    } catch {
      btn.disabled = false;
      btn.textContent = '✓ Approuver';
    }
  }

  // Also wire up approve buttons in the main table
  document.querySelectorAll('.approve-btn').forEach(btn => {
    btn.addEventListener('click', () => approveUser(btn.dataset.id, btn.dataset.username, btn));
  });

  // Remove user modal
  function openRemoveModal(id, username) {
    document.getElementById('removeUserModalText').textContent = `Supprimer le compte "${username}" ? Cette action ne peut pas être annulée.`;
    document.getElementById('removeUserForm').action = `/admin/users/${id}/remove`;
    document.getElementById('removeUserModal').style.display = 'flex';
  }
  window.openRemoveModal = openRemoveModal;

  // Connect SSE
  const evtSource = new EventSource('/admin/users/events');
  evtSource.onmessage = e => {
    try { applyPendingList(JSON.parse(e.data)); } catch {}
  };
  evtSource.onerror = () => {
    // Silently reconnect (browser does this automatically for SSE)
  };
</script>
</body>
</html>
