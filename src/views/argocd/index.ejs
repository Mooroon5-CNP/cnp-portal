<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>
<body>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div>
          <div class="page-title">ArgoCD</div>
          <div class="page-subtitle">Déploiements GitOps — suivi des applications</div>
        </div>
        <% if (argoCDUiUrl) { %>
        <a href="<%= argoCDUiUrl %>" target="_blank" rel="noopener" class="btn btn-primary">Ouvrir ArgoCD ↗</a>
        <% } %>
      </div>

      <!-- ── MANAGER : demandes en attente ─────────────────────────────── -->
      <% if (can('argocd:access:approve') && accessRequests.length > 0) { %>
      <div class="card mb-6" style="border-left:4px solid var(--warning,#f59e0b);">
        <div class="card-header">
          <span class="card-title">Demandes d'accès ArgoCD en attente</span>
          <span class="badge badge-warning"><%= accessRequests.length %></span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Utilisateur</th>
                <th>Application</th>
                <th>Raison</th>
                <th>Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% accessRequests.forEach(r => { %>
              <tr>
                <td class="font-mono"><%= r.userId %></td>
                <td><%= r.appName || '—' %></td>
                <td><%= r.reason %></td>
                <td class="text-muted"><%= new Date(r.createdAt).toLocaleString('fr-FR') %></td>
                <td style="display:flex;gap:8px;">
                  <form action="/argocd/access-request/<%= r.id %>/approve" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-primary btn-sm">Approuver</button>
                  </form>
                  <form action="/argocd/access-request/<%= r.id %>/reject" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-secondary btn-sm">Refuser</button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <!-- ── DEV / DEVOPS : statut de la demande ───────────────────────── -->
      <% if (myRequest === null && can('argocd:access:request')) { %>
      <!-- Pas encore de demande -->
      <div class="card mb-6">
        <div class="card-header"><span class="card-title">Accès ArgoCD</span></div>
        <div class="card-body">
          <p style="margin-bottom:16px;color:var(--text-muted);">
            Vous n'avez pas encore accès à ArgoCD. Envoyez une demande à votre manager — il recevra une notification et pourra l'approuver directement depuis ce portail.
          </p>
          <button onclick="document.getElementById('access-modal').style.display='flex'" class="btn btn-primary">
            Demander un accès
          </button>
        </div>
      </div>

      <% } else if (myRequest && myRequest.status === 'pending') { %>
      <!-- Demande en attente -->
      <div class="card mb-6" style="border-left:4px solid var(--warning,#f59e0b);">
        <div class="card-header">
          <span class="card-title">Accès ArgoCD</span>
          <span class="badge badge-warning">En attente d'approbation</span>
        </div>
        <div class="card-body" style="color:var(--text-muted);">
          <p>Votre demande a été envoyée à votre manager le <strong><%= new Date(myRequest.createdAt).toLocaleString('fr-FR') %></strong>.</p>
          <p style="margin-top:8px;">Raison transmise : <em><%= myRequest.reason %></em></p>
        </div>
      </div>

      <% } else if (myRequest && myRequest.status === 'approved') { %>
      <!-- Accès approuvé + credentials -->
      <div class="card mb-6" style="border-left:4px solid var(--success,#10b981);">
        <div class="card-header">
          <span class="card-title">Vos identifiants ArgoCD</span>
          <span class="badge badge-success">Accès accordé</span>
        </div>
        <div class="card-body">
          <p style="margin-bottom:16px;color:var(--text-muted);font-size:13px;">
            Votre compte a été créé automatiquement. Utilisez les identifiants ci-dessous pour vous connecter à ArgoCD.
            Changez votre mot de passe lors de la première connexion (Settings → Account → Update Password).
          </p>

          <div style="background:var(--bg-secondary,#f9fafb);border-radius:8px;padding:16px 20px;margin-bottom:16px;">

            <% if (argoCDUiUrl) { %>
            <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border,#e5e7eb);">
              <span style="width:140px;color:var(--text-muted);font-size:13px;flex-shrink:0;">1. Ouvrir</span>
              <a href="<%= argoCDUiUrl %>" target="_blank" rel="noopener" style="color:var(--primary);font-family:monospace;font-size:13px;word-break:break-all;"><%= argoCDUiUrl %></a>
            </div>
            <% } %>

            <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border,#e5e7eb);">
              <span style="width:140px;color:var(--text-muted);font-size:13px;flex-shrink:0;">2. Username</span>
              <code style="font-size:14px;flex:1;"><%= myRequest.argoCDUsername %></code>
              <button onclick="navigator.clipboard.writeText('<%= myRequest.argoCDUsername %>').then(()=>{this.textContent='✓';setTimeout(()=>this.textContent='Copier',1500)})" class="btn btn-secondary btn-sm">Copier</button>
            </div>

            <div style="display:flex;align-items:center;gap:12px;padding:10px 0;">
              <span style="width:140px;color:var(--text-muted);font-size:13px;flex-shrink:0;">3. Password</span>
              <code id="argocd-pwd" style="font-size:14px;flex:1;letter-spacing:0.05em;"><%= myRequest.argoCDPassword %></code>
              <button onclick="navigator.clipboard.writeText('<%= myRequest.argoCDPassword %>').then(()=>{this.textContent='✓';setTimeout(()=>this.textContent='Copier',1500)})" class="btn btn-secondary btn-sm">Copier</button>
            </div>
          </div>

          <p style="font-size:12px;color:var(--text-muted);">
            Accès approuvé le <%= new Date(myRequest.updatedAt).toLocaleString('fr-FR') %>.
          </p>
        </div>
      </div>

      <% } else if (myRequest && myRequest.status === 'rejected') { %>
      <!-- Demande refusée -->
      <div class="card mb-6" style="border-left:4px solid var(--danger,#ef4444);">
        <div class="card-header">
          <span class="card-title">Accès ArgoCD</span>
          <span class="badge badge-danger">Refusée</span>
        </div>
        <div class="card-body">
          <p style="color:var(--text-muted);">Votre demande a été refusée. Contactez votre manager pour plus d'informations.</p>
          <button onclick="document.getElementById('access-modal').style.display='flex'" class="btn btn-secondary" style="margin-top:12px;">
            Faire une nouvelle demande
          </button>
        </div>
      </div>
      <% } %>

      <!-- ── Applications ArgoCD (si accès) ────────────────────────────── -->
      <% if (hasAccess) { %>
      <div class="card mb-6">
        <div class="card-header"><span class="card-title">Applications</span></div>
        <% if (apps.length === 0) { %>
        <div class="card-body" style="color:var(--text-muted);text-align:center;padding:32px;">
          Aucune application ArgoCD trouvée ou le serveur est inaccessible.
        </div>
        <% } else { %>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Nom</th>
                <th>Namespace</th>
                <th>Sync</th>
                <th>Santé</th>
                <th>Dernière synchro</th>
                <% if (can('argocd:sync')) { %><th>Actions</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% apps.forEach(app => { %>
              <tr>
                <td class="font-mono"><%= app.name %></td>
                <td class="text-muted"><%= app.namespace || '—' %></td>
                <td>
                  <span class="badge <%= app.status === 'Synced' ? 'badge-success' : app.status === 'OutOfSync' ? 'badge-warning' : 'badge-secondary' %>">
                    <%= app.status %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= app.health === 'Healthy' ? 'badge-success' : app.health === 'Degraded' ? 'badge-danger' : 'badge-secondary' %>">
                    <%= app.health %>
                  </span>
                </td>
                <td class="text-muted" style="font-size:12px;">
                  <%= app.syncedAt ? new Date(app.syncedAt).toLocaleString('fr-FR') : '—' %>
                </td>
                <% if (can('argocd:sync')) { %>
                <td>
                  <form action="/argocd/sync/<%= app.name %>" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-secondary btn-sm">Sync</button>
                  </form>
                </td>
                <% } %>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
      <% } %>

      <!-- ── Modal demande d'accès ──────────────────────────────────────── -->
      <% if (can('argocd:access:request') && (!myRequest || myRequest.status === 'rejected')) { %>
      <div id="access-modal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:200;align-items:center;justify-content:center;">
        <div class="card" style="width:460px;">
          <div class="card-header">
            <span class="card-title">Demande d'accès ArgoCD</span>
            <button onclick="document.getElementById('access-modal').style.display='none'" style="background:none;border:none;cursor:pointer;font-size:20px;color:var(--text-muted);">×</button>
          </div>
          <div class="card-body">
            <p style="margin-bottom:16px;color:var(--text-muted);font-size:13px;">
              Votre manager recevra une notification ici et pourra créer votre compte ArgoCD directement depuis ce portail.
            </p>
            <form action="/argocd/access-request" method="POST">
              <div class="form-group">
                <label>Application cible (optionnel)</label>
                <input type="text" name="appName" placeholder="ex: cnp-portal">
              </div>
              <div class="form-group">
                <label>Raison de la demande</label>
                <textarea name="reason" rows="3" placeholder="Pourquoi avez-vous besoin d'un accès ArgoCD ?" required></textarea>
              </div>
              <div style="display:flex;gap:10px;">
                <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                <button type="button" onclick="document.getElementById('access-modal').style.display='none'" class="btn btn-secondary">Annuler</button>
              </div>
            </form>
          </div>
        </div>
      </div>
      <% } %>

    </div>
  </main>
</div>
</body>
</html>
