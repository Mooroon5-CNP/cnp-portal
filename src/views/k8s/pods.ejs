<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>
<style>
  .quota-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
    gap: 16px;
    padding: 16px 20px;
  }
  .quota-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    overflow: hidden;
  }
  .quota-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--sidebar-bg, #f8fafc);
  }
  .quota-ns {
    font-family: monospace;
    font-size: 13px;
    font-weight: 700;
    color: var(--text);
  }
  .quota-rows { padding: 12px 16px; display: flex; flex-direction: column; gap: 10px; }
  .quota-row { display: flex; flex-direction: column; gap: 4px; }
  .quota-label {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-muted);
  }
  .quota-label span:last-child { font-family: monospace; color: var(--text); font-size: 12px; }
  .progress-bar {
    height: 6px;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    border-radius: 4px;
    transition: width .3s;
  }
  .fill-ok     { background: #22c55e; }
  .fill-warn   { background: #f59e0b; }
  .fill-danger { background: #ef4444; }
  .quota-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 16px 12px;
    border-top: 1px solid var(--border);
  }
  .meta-chip {
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 4px;
    background: var(--hover-bg, #f1f5f9);
    color: var(--text-muted);
  }
  .meta-chip strong { color: var(--text); }
</style>
<body>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div>
          <div class="page-title">Ressources Kubernetes</div>
          <div class="page-subtitle">Quotas de ressources et événements — filtrés sur vos applications</div>
        </div>
      </div>

      <!-- Editable apps shortcut (devops with write access) -->
      <% if (editableAppNames && editableAppNames.length > 0) { %>
      <div class="card mb-6">
        <div class="card-header">
          <span class="card-title">Applications — accès écriture</span>
          <span class="badge badge-success"><%= editableAppNames.length %> app(s)</span>
        </div>
        <div style="padding:14px 20px;display:flex;flex-wrap:wrap;gap:10px;">
          <% editableAppNames.forEach(function(appName) { %>
          <a href="/k8s/apps/<%= appName %>/edit" class="btn btn-secondary">
            ✏ <%= appName %>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Resource Quotas -->
      <div class="card mb-6">
        <div class="card-header">
          <span class="card-title">Resource Quotas</span>
          <span class="badge badge-gray"><%= quotas.length %> namespace(s)</span>
        </div>

        <% if (quotas.length === 0) { %>
        <div style="padding:32px;text-align:center;color:var(--text-muted);">Aucun quota trouvé</div>
        <% } else { %>
        <div class="quota-grid">
          <% quotas.forEach(q => {
            function fillClass(pct) {
              if (pct === null) return 'fill-ok';
              if (pct >= 90) return 'fill-danger';
              if (pct >= 70) return 'fill-warn';
              return 'fill-ok';
            }
          %>
          <div class="quota-card">
            <div class="quota-card-header">
              <span class="quota-ns"><%= q.namespace %></span>
              <% if (q.podsPct !== null && q.podsPct >= 90) { %>
                <span class="badge badge-danger">Quota critique</span>
              <% } else if (q.cpuRequestPct !== null && q.cpuRequestPct >= 90 || q.memRequestPct !== null && q.memRequestPct >= 90) { %>
                <span class="badge badge-warning">Quota élevé</span>
              <% } else { %>
                <span class="badge badge-success">OK</span>
              <% } %>
            </div>

            <div class="quota-rows">
              <!-- CPU Requests -->
              <% if (q.cpuRequest !== '—') { %>
              <div class="quota-row">
                <div class="quota-label">
                  <span>CPU Requests</span>
                  <span><%= q.usedCpuRequest %> / <%= q.cpuRequest %><% if (q.cpuRequestPct !== null) { %> (<%= q.cpuRequestPct %>%)<% } %></span>
                </div>
                <% if (q.cpuRequestPct !== null) { %>
                <div class="progress-bar"><div class="progress-fill <%= fillClass(q.cpuRequestPct) %>" style="width:<%= q.cpuRequestPct %>%"></div></div>
                <% } %>
              </div>
              <% } %>

              <!-- CPU Limits -->
              <% if (q.cpuLimit !== '—') { %>
              <div class="quota-row">
                <div class="quota-label">
                  <span>CPU Limits</span>
                  <span><%= q.usedCpuLimit %> / <%= q.cpuLimit %><% if (q.cpuLimitPct !== null) { %> (<%= q.cpuLimitPct %>%)<% } %></span>
                </div>
                <% if (q.cpuLimitPct !== null) { %>
                <div class="progress-bar"><div class="progress-fill <%= fillClass(q.cpuLimitPct) %>" style="width:<%= q.cpuLimitPct %>%"></div></div>
                <% } %>
              </div>
              <% } %>

              <!-- Memory Requests -->
              <% if (q.memRequest !== '—') { %>
              <div class="quota-row">
                <div class="quota-label">
                  <span>Mémoire Requests</span>
                  <span><%= q.usedMemRequest %> / <%= q.memRequest %><% if (q.memRequestPct !== null) { %> (<%= q.memRequestPct %>%)<% } %></span>
                </div>
                <% if (q.memRequestPct !== null) { %>
                <div class="progress-bar"><div class="progress-fill <%= fillClass(q.memRequestPct) %>" style="width:<%= q.memRequestPct %>%"></div></div>
                <% } %>
              </div>
              <% } %>

              <!-- Memory Limits -->
              <% if (q.memLimit !== '—') { %>
              <div class="quota-row">
                <div class="quota-label">
                  <span>Mémoire Limits</span>
                  <span><%= q.usedMemLimit %> / <%= q.memLimit %><% if (q.memLimitPct !== null) { %> (<%= q.memLimitPct %>%)<% } %></span>
                </div>
                <% if (q.memLimitPct !== null) { %>
                <div class="progress-bar"><div class="progress-fill <%= fillClass(q.memLimitPct) %>" style="width:<%= q.memLimitPct %>%"></div></div>
                <% } %>
              </div>
              <% } %>

              <!-- Pods -->
              <% if (q.pods !== null) { %>
              <div class="quota-row">
                <div class="quota-label">
                  <span>Pods</span>
                  <span><%= q.usedPods !== null ? q.usedPods : '—' %> / <%= q.pods %><% if (q.podsPct !== null) { %> (<%= q.podsPct %>%)<% } %></span>
                </div>
                <% if (q.podsPct !== null) { %>
                <div class="progress-bar"><div class="progress-fill <%= fillClass(q.podsPct) %>" style="width:<%= q.podsPct %>%"></div></div>
                <% } %>
              </div>
              <% } %>

              <!-- Storage -->
              <% if (q.storage !== '—') { %>
              <div class="quota-row">
                <div class="quota-label">
                  <span>Stockage (PVC)</span>
                  <span><%= q.usedStorage %> / <%= q.storage %><% if (q.storagePct !== null) { %> (<%= q.storagePct %>%)<% } %></span>
                </div>
                <% if (q.storagePct !== null) { %>
                <div class="progress-bar"><div class="progress-fill <%= fillClass(q.storagePct) %>" style="width:<%= q.storagePct %>%"></div></div>
                <% } %>
              </div>
              <% } %>
            </div>

            <!-- PVC count meta chip -->
            <% if (q.pvcs !== null) { %>
            <div class="quota-meta">
              <span class="meta-chip">PVCs : <strong><%= q.usedPvcs !== null ? q.usedPvcs : '—' %> / <%= q.pvcs %></strong></span>
            </div>
            <% } %>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>

      <!-- Events (manager/devops only) -->
      <% if (can('k8s:events:view') && events.length > 0) { %>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Événements K8s</span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Namespace</th><th>Type</th><th>Raison</th><th>Message</th><th>Compteur</th><th>Dernière occurrence</th></tr>
            </thead>
            <tbody>
              <% events.forEach(ev => { %>
              <tr>
                <td><span class="badge badge-gray"><%= ev.namespace %></span></td>
                <td>
                  <% if (ev.type === 'Warning') { %><span class="badge badge-warning"><%= ev.type %></span>
                  <% } else { %><span class="badge badge-info"><%= ev.type %></span>
                  <% } %>
                </td>
                <td><strong><%= ev.reason %></strong></td>
                <td style="max-width:400px;font-size:12.5px;"><%= ev.message %></td>
                <td><%= ev.count %></td>
                <td class="text-muted"><%= ev.lastSeen %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </div>
  </main>
</div>
</body>
</html>
