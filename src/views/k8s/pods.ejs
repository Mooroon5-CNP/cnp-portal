<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>
<body>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div>
          <div class="page-title">Ressources Kubernetes</div>
          <div class="page-subtitle">Pods, quotas et événements — filtrés sur vos applications</div>
        </div>
      </div>

      <!-- Editable apps shortcut (devops with write access) -->
      <% if (editableAppNames && editableAppNames.length > 0) { %>
      <div class="card mb-6">
        <div class="card-header">
          <span class="card-title">Applications — accès écriture</span>
          <span class="badge badge-success"><%= editableAppNames.length %> app(s)</span>
        </div>
        <div style="padding:14px 20px;display:flex;flex-wrap:wrap;gap:10px;">
          <% editableAppNames.forEach(function(appName) { %>
          <a href="/k8s/apps/<%= appName %>/edit" class="btn btn-secondary">
            ✏ <%= appName %>
          </a>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Pods -->
      <div class="card mb-6">
        <div class="card-header">
          <span class="card-title">Pods</span>
          <span class="badge badge-gray"><%= pods.length %> pods</span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Nom</th>
                <th>Namespace</th>
                <th>Application</th>
                <th>Statut</th>
                <th>Restarts</th>
                <th>Age</th>
                <% if (can('k8s:pods:scale') || can('k8s:pods:delete') || can('k8s:manifest:edit')) { %><th>Actions</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% pods.forEach(pod => {
                // Resolve the DB app name for this pod: direct label match OR namespace-based fallback.
                const resolvedApp = (editableAppNames || []).find(n =>
                  n === pod.app || pod.namespace === n + '-dev' || pod.namespace === n + '-prod'
                ) || (userAppNames || []).find(n =>
                  n === pod.app || pod.namespace === n + '-dev' || pod.namespace === n + '-prod'
                ) || pod.app;
                const isEditable = (editableAppNames || []).includes(resolvedApp);
              %>
              <tr>
                <td class="font-mono"><%= pod.name %></td>
                <td><span class="badge badge-gray"><%= pod.namespace %></span></td>
                <td><%= pod.app %></td>
                <td>
                  <% if (pod.status === 'Running') { %><span class="badge badge-success"><%= pod.status %></span>
                  <% } else if (pod.status === 'Pending') { %><span class="badge badge-info"><%= pod.status %></span>
                  <% } else { %><span class="badge badge-danger"><%= pod.status %></span>
                  <% } %>
                </td>
                <td><% if (pod.restarts > 5) { %><span class="text-danger"><strong><%= pod.restarts %></strong></span><% } else { %><%= pod.restarts %><% } %></td>
                <td class="text-muted"><%= pod.age %></td>
                <% if (can('k8s:pods:scale') || can('k8s:pods:delete') || can('k8s:manifest:edit')) { %>
                <td>
                  <div class="actions-cell">
                    <% if (can('k8s:pods:scale') && (user.role === 'manager' || isEditable)) { %>
                    <form action="/k8s/deployments/<%= resolvedApp %>/scale" method="POST" class="scale-form">
                      <input type="hidden" name="namespace" value="<%= pod.namespace %>">
                      <input type="number" name="replicas" value="1" min="0" max="20" title="Réplicas">
                      <button type="submit" class="btn btn-secondary btn-sm">Scale</button>
                    </form>
                    <% } %>
                    <% if (can('k8s:manifest:edit') && isEditable) { %>
                    <a href="/k8s/apps/<%= resolvedApp %>/edit" class="btn btn-secondary btn-sm">Edit YAML</a>
                    <% } %>
                    <% if (can('k8s:pods:delete') && (user.role === 'manager' || isEditable)) { %>
                    <form action="/k8s/pods/<%= pod.name %>/delete" method="POST" class="inline-form"
                          onsubmit="return confirm('Supprimer le pod <%= pod.name %> ?')">
                      <input type="hidden" name="namespace" value="<%= pod.namespace %>">
                      <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                    </form>
                    <% } %>
                  </div>
                </td>
                <% } %>
              </tr>
              <% }) %>
              <% if (pods.length === 0) { %>
              <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:32px;">Aucun pod trouvé</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Resource quotas -->
      <div class="card mb-6">
        <div class="card-header">
          <span class="card-title">Resource Quotas</span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Namespace</th><th>CPU Request</th><th>CPU Limit</th><th>Mem Request</th><th>Mem Limit</th><th>CPU utilisé</th><th>Mem utilisée</th></tr>
            </thead>
            <tbody>
              <% quotas.forEach(q => { %>
              <tr>
                <td><span class="badge badge-gray"><%= q.namespace %></span></td>
                <td class="font-mono"><%= q.cpuRequest %></td>
                <td class="font-mono"><%= q.cpuLimit %></td>
                <td class="font-mono"><%= q.memRequest %></td>
                <td class="font-mono"><%= q.memLimit %></td>
                <td class="font-mono"><%= q.usedCpuRequest %></td>
                <td class="font-mono"><%= q.usedMemRequest %></td>
              </tr>
              <% }) %>
              <% if (quotas.length === 0) { %>
              <tr><td colspan="7" style="text-align:center;color:var(--text-muted);padding:20px;">Aucun quota trouvé</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Events (manager/devops only) -->
      <% if (can('k8s:events:view') && events.length > 0) { %>
      <div class="card">
        <div class="card-header">
          <span class="card-title">Événements K8s</span>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Namespace</th><th>Type</th><th>Raison</th><th>Message</th><th>Compteur</th><th>Dernière occurrence</th></tr>
            </thead>
            <tbody>
              <% events.forEach(ev => { %>
              <tr>
                <td><span class="badge badge-gray"><%= ev.namespace %></span></td>
                <td>
                  <% if (ev.type === 'Warning') { %><span class="badge badge-warning"><%= ev.type %></span>
                  <% } else { %><span class="badge badge-info"><%= ev.type %></span>
                  <% } %>
                </td>
                <td><strong><%= ev.reason %></strong></td>
                <td style="max-width:400px;font-size:12.5px;"><%= ev.message %></td>
                <td><%= ev.count %></td>
                <td class="text-muted"><%= ev.lastSeen %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

    </div>
  </main>
</div>
</body>
</html>
