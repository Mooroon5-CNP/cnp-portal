<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { title: title }) %>
<body>
<div class="login-page">
  <div class="login-card">
    <div class="login-logo">CNP Portal</div>
    <div class="login-tagline">
      <% if (forced) { %>Première connexion : choisissez votre mot de passe.<% } else { %>Changer mon mot de passe<% } %>
    </div>

    <% if (locals.flash && flash.error && flash.error.length) { %>
      <% flash.error.forEach(msg => { %>
        <div class="flash flash-error" style="margin-bottom:20px; text-align:left;">✗ <%= msg %></div>
      <% }) %>
    <% } %>

    <form action="/auth/change-password" method="POST" style="display:flex;flex-direction:column;gap:12px;">
      <input type="password" name="currentPassword" placeholder="Mot de passe temporaire" autocomplete="current-password"
        style="padding:10px 14px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:14px;outline:none;" required>
      <input type="password" name="newPassword" placeholder="Nouveau mot de passe (12 caractères minimum)" autocomplete="new-password" minlength="12" maxlength="72"
        style="padding:10px 14px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:14px;outline:none;" required>
      <input type="password" name="confirmPassword" placeholder="Confirmer le nouveau mot de passe" autocomplete="new-password" minlength="12" maxlength="72"
        style="padding:10px 14px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:6px;color:var(--text-primary);font-size:14px;outline:none;" required>
      <button type="submit" class="btn btn-primary" style="width:100%;padding:10px;font-size:14px;">Enregistrer</button>
    </form>

    <form action="/auth/logout" method="POST" style="margin-top:16px;">
      <button type="submit" class="btn btn-secondary" style="width:100%;">Déconnexion</button>
    </form>
  </div>
</div>
</body>
</html>
