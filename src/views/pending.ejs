<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { title: title }) %>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">

      <div style="max-width:640px;margin:60px auto;">

        <div style="background:rgba(234,179,8,0.08);border:1px solid rgba(234,179,8,0.35);border-radius:12px;padding:32px 36px;text-align:center;">
          <div style="width:56px;height:56px;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;">
            <svg viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg" width="56" height="56">
              <circle cx="28" cy="28" r="26" stroke="rgba(234,179,8,0.4)" stroke-width="1.5"/>
              <circle cx="28" cy="28" r="18" fill="rgba(234,179,8,0.1)" stroke="#eab308" stroke-width="1.5"/>
              <path d="M28 18v11l6 3.5" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <h2 style="font-size:20px;font-weight:700;margin:0 0 10px;color:var(--text);">Compte en attente d'approbation</h2>
          <p style="color:var(--text-muted);font-size:14px;line-height:1.6;margin:0 0 24px;">
            Votre compte a été créé avec succès. Un administrateur doit valider votre accès avant que vous puissiez utiliser la plateforme.<br>
            Vous serez notifié dès que votre accès est activé.
          </p>

          <% if (user) { %>
          <div style="display:inline-flex;align-items:center;gap:10px;background:var(--surface-alt,#f8f9fa);border:1px solid var(--border);border-radius:40px;padding:8px 18px 8px 8px;margin-bottom:24px;">
            <% if (user.avatarUrl) { %>
              <img src="<%= user.avatarUrl %>" alt="avatar" width="28" height="28" style="border-radius:50%;object-fit:cover;">
            <% } else { %>
              <div style="width:28px;height:28px;border-radius:50%;background:var(--accent,#6366f1);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:600;flex-shrink:0;"><%= (user.username || '?')[0].toUpperCase() %></div>
            <% } %>
            <span style="font-size:13px;color:var(--text-muted);"><%= user.email || user.username %></span>
          </div>
          <% } %>

          <div style="display:flex;flex-direction:column;gap:10px;text-align:left;margin-bottom:28px;">
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 6px rgba(34,197,94,0.6);flex-shrink:0;"></div>
              <span style="font-size:13px;color:var(--text);">Compte créé</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:8px;height:8px;border-radius:50%;background:#eab308;box-shadow:0 0 8px rgba(234,179,8,0.7);flex-shrink:0;animation:pendingBlink 1.4s ease-in-out infinite;"></div>
              <span style="font-size:13px;color:var(--text);font-weight:600;">En attente d'approbation admin</span>
            </div>
            <div style="display:flex;align-items:center;gap:12px;">
              <div style="width:8px;height:8px;border-radius:50%;background:var(--border);flex-shrink:0;"></div>
              <span style="font-size:13px;color:var(--text-muted);">Accès à la plateforme</span>
            </div>
          </div>

          <form action="/auth/logout" method="POST">
            <button type="submit" class="btn btn-ghost" style="font-size:13px;">Se déconnecter</button>
          </form>
        </div>
      </div>

    </div>
  </main>
</div>

<style>
@keyframes pendingBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}
</style>
</body>
</html>
