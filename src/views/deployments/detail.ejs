<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>

  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>
        <main class="main-content">
          <div class="content-wrapper">
            <%- include('../partials/flash') %>

              <div class="page-header">
                <div>
                  <div class="page-title"><%= deployment.appName %></div>
                  <div class="page-subtitle" style="display:flex;align-items:center;gap:8px;">
                    Détails du pipeline
                    <% if (ownerTeam) { %>
                    <a href="/deployments?team=<%= ownerTeam.id %>" class="badge badge-gray" style="text-decoration:none;font-size:12px;"><%= ownerTeam.name %></a>
                    <% } %>
                  </div>
                </div>
                <div style="display:flex;gap:8px;align-items:center;">
                  <% if (can('deployments:delete')) { %>
                    <% if (pendingDeletion) { %>
                      <span class="badge badge-warning">Suppression demandée</span>
                      <button class="btn btn-danger btn-sm" onclick="document.getElementById('approveDeleteModal').style.display='flex'">Approuver</button>
                      <form action="/deployments/<%= deployment.id %>/reject-delete" method="POST" class="inline-form">
                        <button type="submit" class="btn btn-secondary btn-sm">Refuser</button>
                      </form>
                    <% } else { %>
                      <button class="btn btn-danger btn-sm" onclick="document.getElementById('deleteModal').style.display='flex'">Supprimer</button>
                    <% } %>
                  <% } else if (can('deployments:delete:request')) { %>
                    <% if (pendingDeletion) { %>
                      <span class="badge badge-warning">Demande de suppression en attente</span>
                    <% } else { %>
                      <button class="btn btn-secondary btn-sm" onclick="document.getElementById('requestDeleteModal').style.display='flex'">Demander suppression</button>
                    <% } %>
                  <% } %>
                  <a href="/deployments" class="btn btn-secondary">← Retour</a>
                </div>
              </div>

              <% if (pendingDeletion && can('deployments:delete')) { %>
                <div class="flash flash-error" style="margin-bottom:16px;">
                  <strong>Demande de suppression en attente</strong> — soumise le <%= new Date(pendingDeletion.createdAt).toLocaleString('fr-FR') %><% if (pendingDeletion.reason) { %> : "<%= pendingDeletion.reason %>"<% } %>.
                </div>
              <% } %>

              <!-- ── Tab navigation ─────────────────────────────────────── -->
              <div style="display:flex;border-bottom:2px solid var(--border);margin-bottom:20px;margin-top:4px;">
                <button id="tab-btn-pipeline" onclick="switchTab('pipeline')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-size:14px;font-weight:600;color:var(--primary);border-bottom:2px solid var(--primary);margin-bottom:-2px;">Pipeline</button>
                <button id="tab-btn-observability" onclick="switchTab('observability')" style="padding:10px 20px;border:none;background:none;cursor:pointer;font-size:14px;font-weight:600;color:var(--text-muted);border-bottom:2px solid transparent;margin-bottom:-2px;">Observabilité</button>
              </div>
              <div id="tab-pipeline">

              <!-- ── Onboarding: configuring ─────────────────────────────── -->
              <% if (deployment.onboardingStatus === 'configuring') { %>
                <div id="onboarding-card" class="card">
                  <div class="card-header">
                    <span class="card-title">Configuration en cours</span>
                    <span class="badge badge-warning">En cours</span>
                  </div>
                  <div class="card-body">
                    <div style="display:flex;align-items:center;gap:12px;padding:12px 0;color:var(--text-muted);">
                      <span style="font-size:22px;animation:spin 1.2s linear infinite;display:inline-block;">⟳</span>
                      <span>La plateforme configure votre application — merci de patienter...</span>
                    </div>
                    <div style="display:flex;flex-direction:column;gap:8px;padding:8px 0;font-size:13px;color:var(--text-muted);">
                      <div>⏳ Création des manifests Kubernetes dans config-repo</div>
                      <div>⏳ Enregistrement dans le registre applicatif</div>
                      <div>⏳ Création du pipeline CI/CD dans le dépôt</div>
                      <div>⏳ Injection du secret <code>CONFIG_REPO_TOKEN</code></div>
                      <div>⏳ Création de la branche <code>prod</code></div>
                      <div>⏳ Déclenchement du premier pipeline</div>
                    </div>
                  </div>
                </div>
                <style>@keyframes spin { to { transform: rotate(360deg); } }</style>

              <!-- ── Onboarding: failed (setup error) ───────────────────── -->
              <% } else if (deployment.onboardingStatus === 'failed' && !latest) { %>
                <div class="card">
                  <div class="card-header">
                    <span class="card-title">Échec de la configuration</span>
                    <span class="badge badge-danger">Erreur</span>
                  </div>
                  <div class="card-body">
                    <div class="flash flash-error">
                      <strong>Votre pipeline a échoué. Veuillez vérifier la configuration de votre application.</strong>
                      <% if (deployment.onboardingError) { %>
                        <div style="margin-top:8px;font-size:13px;color:inherit;opacity:0.85;">
                          Détail : <%= deployment.onboardingError %>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>

              <!-- ── Ready: show pipeline runs ──────────────────────────── -->
              <% } else { %>
                <% if (cloudRunUrl) { %>
                  <div class="card" style="margin-bottom:16px;" id="url-card">
                    <div class="card-header"><span class="card-title">Application disponible</span></div>
                    <div class="card-body" style="display:flex;align-items:center;gap:12px;">
                      <a href="<%= cloudRunUrl %>" target="_blank" rel="noreferrer" class="btn btn-primary">Ouvrir l'application ↗</a>
                      <span style="font-family:monospace;font-size:13px;color:var(--text-muted);"><%= cloudRunUrl %></span>
                    </div>
                  </div>
                <% } else if (deployment.targetCluster === 'gcp') { %>
                  <div class="card" style="margin-bottom:16px;" id="url-card">
                    <div class="card-header"><span class="card-title">Application</span></div>
                    <div class="card-body" id="url-card-body" style="display:flex;align-items:center;gap:12px;color:var(--text-muted);">
                      <span id="url-card-spinner" style="font-size:18px;animation:spin 1.2s linear infinite;display:inline-block;">⟳</span>
                      <span id="url-card-msg">Provisionnement Cloud Run en cours...</span>
                    </div>
                  </div>
                <% } %>
                <!-- Final status banner (shown once CI has a result) -->
                <% if (latest && latest.status === 'completed') { %>
                  <% if (latest.conclusion === 'success') { %>
                    <div class="flash flash-success" style="margin-bottom:16px;">
                      <strong>Votre application a été déployée avec succès.</strong>
                      <% if (cloudRunUrl) { %>
                        &nbsp;—&nbsp;<a href="<%= cloudRunUrl %>" target="_blank" rel="noreferrer" style="color:inherit;text-decoration:underline;font-weight:600;"><%= cloudRunUrl %> ↗</a>
                      <% } %>
                    </div>
                  <% } else if (latest.conclusion === 'failure') { %>
                    <div class="flash flash-error" style="margin-bottom:16px;">
                      <strong>Votre pipeline a échoué. Veuillez vérifier la configuration de votre application.</strong>
                    </div>
                  <% } %>
                <% } %>

                <div class="card">
                  <div class="card-header">
                    <span class="card-title">Dernière exécution</span>
                    <% if (latest) { %>
                      <a href="<%= githubActionsUrl %>" class="btn btn-ghost" target="_blank" rel="noreferrer">
                        Voir sur GitHub Actions
                      </a>
                    <% } %>
                  </div>
                  <div class="card-body">
                    <% if (!latest) { %>
                      <div id="waiting-run" style="color:var(--text-muted);">
                        En attente du premier pipeline CI...
                        <span style="margin-left:8px;">⏳</span>
                      </div>
                    <% } else { %>
                      <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
                        <div>
                          <div><strong>ID</strong></div>
                          <div class="font-mono"><%= latest.id %></div>
                        </div>
                        <div>
                          <div><strong>Trigger</strong></div>
                          <div><%= latest.event %></div>
                        </div>
                        <div>
                          <div><strong>Statut</strong></div>
                          <div>
                            <span class="badge <%= (latest.status === 'in_progress' || latest.status === 'queued') ? 'badge-warning' : (latest.conclusion === 'success' ? 'badge-success' : (latest.conclusion === 'failure' ? 'badge-danger' : 'badge-gray')) %>">
                              <%= latest.status === 'in_progress' ? 'CI en cours' : latest.status === 'queued' ? 'En file' : (latest.conclusion || latest.status) %>
                            </span>
                          </div>
                        </div>
                        <div>
                          <div><strong>Début</strong></div>
                          <div class="text-muted"><%= latest.run_started_at || latest.created_at %></div>
                        </div>
                      </div>

                      <h4 style="margin-top:18px;margin-bottom:8px;">Jobs</h4>
                      <div>
                        <% jobs.forEach(job => { %>
                          <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);">
                            <div style="flex:1;">
                              <div style="font-weight:600;"><%= job.name %></div>
                              <div class="text-muted" style="font-size:12px;">
                                Durée: <%= job.completed_at && job.started_at ? Math.max(0, new Date(job.completed_at) - new Date(job.started_at)) : '-' %> ms
                              </div>
                            </div>
                            <div style="display:flex;gap:8px;align-items:center;">
                              <% if (job.status === 'in_progress') { %>
                                <span class="badge badge-warning">En cours</span>
                              <% } else if (job.conclusion === 'success') { %>
                                <span class="badge badge-success">Succès</span>
                              <% } else if (job.conclusion === 'failure') { %>
                                <span class="badge badge-danger">Échec</span>
                              <% } else { %>
                                <span class="badge badge-gray"><%= job.status || job.conclusion %></span>
                              <% } %>
                              <a href="<%= githubActionsUrl %>" target="_blank" rel="noreferrer" class="btn btn-sm btn-ghost">
                                Logs
                              </a>
                            </div>
                          </div>
                        <% }) %>
                      </div>

                      <% if (failureHint) { %>
                        <div class="flash flash-error mt-4">
                          <strong>Indice :</strong> <%= failureHint %>
                        </div>
                      <% } %>
                    <% } %>
                  </div>
                </div>
              <% } %>

              <!-- ── Team access panel (devops + manager) ─────────────────────── -->
              <% if (can('deployments:manage-team-access')) { %>
              <div class="card" style="margin-top:20px;">
                <div class="card-header">
                  <span class="card-title">Accès par équipe</span>
                </div>
                <div class="card-body">
                  <% if (accessTeams.length === 0) { %>
                    <p style="color:var(--text-muted);font-size:13px;margin:0;">Aucune équipe n'a accès à ce déploiement en dehors de ses membres directs.</p>
                  <% } else { %>
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                      <thead>
                        <tr style="border-bottom:1px solid var(--border);">
                          <th style="text-align:left;padding:6px 8px;font-weight:600;">Équipe</th>
                          <th style="text-align:left;padding:6px 8px;font-weight:600;">Rôle</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% accessTeams.forEach(t => { %>
                        <tr style="border-bottom:1px solid var(--border);">
                          <td style="padding:6px 8px;"><strong><%= t.name %></strong></td>
                          <td style="padding:6px 8px;">
                            <% if (ownerTeam && t.id === ownerTeam.id) { %>
                              <span class="badge badge-success">Propriétaire</span>
                            <% } else if (t.permissionLevel === 'write') { %>
                              <span class="badge badge-warning" title="Peut éditer les fichiers YAML K8s">Écriture</span>
                            <% } else { %>
                              <span class="badge badge-gray">Lecture</span>
                            <% } %>
                          </td>
                          <td style="padding:6px 8px;text-align:right;">
                            <% if (!ownerTeam || t.id !== ownerTeam.id) { %>
                            <form action="/deployments/<%= deployment.id %>/team-access/<%= t.id %>/revoke" method="POST" class="inline-form">
                              <button type="submit" class="btn btn-secondary btn-sm">Révoquer</button>
                            </form>
                            <% } %>
                          </td>
                        </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  <% } %>

                  <% if (otherTeams.length > 0) { %>
                  <form action="/deployments/<%= deployment.id %>/team-access" method="POST" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:16px;padding-top:16px;border-top:1px solid var(--border);">
                    <select name="teamId" style="flex:1;min-width:160px;max-width:240px;">
                      <% otherTeams.forEach(t => { %>
                      <option value="<%= t.id %>"><%= t.name %></option>
                      <% }) %>
                    </select>
                    <select name="permissionLevel" style="width:160px;" title="Niveau d'accès">
                      <option value="read">👁 Lecture seule</option>
                      <option value="write">✏️ Écriture (YAML K8s)</option>
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Donner accès</button>
                  </form>
                  <% } %>
                </div>
              </div>
              <% } %>

              <!-- ── Pending manifest MRs (manager only) ────────────────── -->
              <% if (can('k8s:manifest:approve') && pendingMrs && pendingMrs.length > 0) { %>
              <div class="card mb-6">
                <div class="card-header">
                  <span class="card-title">Modifications de manifestes en attente</span>
                  <span class="badge badge-warning"><%= pendingMrs.length %> en attente</span>
                </div>
                <div class="table-container">
                  <table>
                    <thead>
                      <tr><th>Fichier</th><th>Demandé par</th><th>Message</th><th>GitHub PR</th><th>Date</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                      <% pendingMrs.forEach(mr => { %>
                      <tr>
                        <td class="font-mono" style="font-size:12px;"><%= mr.filePath.split('/').pop() %></td>
                        <td><%= (mrUsers[mr.requestedBy] || {}).username || mr.requestedBy %></td>
                        <td style="max-width:200px;font-size:12px;color:var(--text-muted);"><%= mr.commitMessage || '—' %></td>
                        <td>
                          <% if (mr.prUrl) { %>
                          <a href="<%= mr.prUrl %>" target="_blank" class="badge badge-info" style="text-decoration:none;">#<%= mr.prNumber %> ↗</a>
                          <% } else { %>—<% } %>
                        </td>
                        <td class="text-muted" style="font-size:12px;"><%= new Date(mr.createdAt).toLocaleDateString('fr-FR') %></td>
                        <td>
                          <div class="actions-cell">
                            <form action="/deployments/<%= deployment.id %>/manifest-prs/<%= mr.id %>/approve" method="POST" class="inline-form"
                                  onsubmit="return confirm('Approuver et merger cette modification ?')">
                              <button type="submit" class="btn btn-primary btn-sm">Approuver</button>
                            </form>
                            <button class="btn btn-secondary btn-sm" onclick="document.getElementById('rejectModal-<%= mr.id %>').style.display='flex'">Rejeter</button>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              </div>
              <% } %>
              </div><!-- /tab-pipeline -->
              <div id="tab-observability" style="display:none;">
                <%- include('../partials/observability-tab') %>
              </div>

          </div>
        </main>
    </div>

    <!-- ── Reject MR modals (manager) ───────────────────────────────────── -->
    <% if (can('k8s:manifest:approve') && pendingMrs) { pendingMrs.forEach(mr => { %>
    <div id="rejectModal-<%= mr.id %>" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
      <div style="background:var(--surface);width:480px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
        <h3 style="margin:0 0 8px;">Rejeter la modification</h3>
        <p style="color:var(--text-muted);margin-bottom:12px;">Fichier : <code><%= mr.filePath.split('/').pop() %></code></p>
        <form action="/deployments/<%= deployment.id %>/manifest-prs/<%= mr.id %>/reject" method="POST">
          <div class="form-group">
            <label>Motif du rejet (optionnel)</label>
            <textarea name="comment" rows="3" style="width:100%;resize:vertical;" placeholder="Expliquez pourquoi cette modification est rejetée..."></textarea>
          </div>
          <div style="display:flex;gap:10px;margin-top:12px;">
            <button type="submit" class="btn btn-danger">Confirmer le rejet</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('rejectModal-<%= mr.id %>').style.display='none'">Annuler</button>
          </div>
        </form>
      </div>
    </div>
    <% }) } %>

    <!-- ── Delete modal (manager) ──────────────────────────────────────── -->
    <div id="deleteModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
      <div style="background:var(--surface);width:480px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
        <h3 style="margin:0 0 8px;">Supprimer l'application</h3>
        <p style="color:var(--text-muted);margin-bottom:12px;">Supprimer "<strong><%= deployment.appName %></strong>" et toutes ses ressources ?</p>
        <div class="flash flash-error" style="margin-bottom:16px;font-size:13px;">
          Les manifests Kubernetes dans config-repo, le pipeline CI/CD et les secrets GitHub seront définitivement supprimés.
        </div>
        <form action="/deployments/<%= deployment.id %>/delete" method="POST">
          <div style="display:flex;gap:10px;">
            <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('deleteModal').style.display='none'">Annuler</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Approve deletion modal (manager reviewing a request) ─────────── -->
    <div id="approveDeleteModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
      <div style="background:var(--surface);width:480px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
        <h3 style="margin:0 0 8px;">Approuver la suppression</h3>
        <p style="color:var(--text-muted);margin-bottom:12px;">Approuver la demande de suppression de "<strong><%= deployment.appName %></strong>" ?</p>
        <div class="flash flash-error" style="margin-bottom:16px;font-size:13px;">
          Cela supprimera définitivement l'application et toutes ses ressources.
        </div>
        <form action="/deployments/<%= deployment.id %>/approve-delete" method="POST">
          <div style="display:flex;gap:10px;">
            <button type="submit" class="btn btn-danger">Confirmer et supprimer</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('approveDeleteModal').style.display='none'">Annuler</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Request deletion modal (dev/devops) ──────────────────────────── -->
    <div id="requestDeleteModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
      <div style="background:var(--surface);width:480px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
        <h3 style="margin:0 0 8px;">Demander la suppression</h3>
        <p style="color:var(--text-muted);margin-bottom:16px;">Un manager devra valider cette demande avant que l'application soit supprimée.</p>
        <form action="/deployments/<%= deployment.id %>/request-delete" method="POST">
          <div class="form-group">
            <label for="deleteReason">Raison (optionnel)</label>
            <textarea name="reason" id="deleteReason" rows="3" style="width:100%;resize:vertical;" placeholder="Expliquez pourquoi cette application doit être supprimée..."></textarea>
          </div>
          <div style="display:flex;gap:10px;margin-top:12px;">
            <button type="submit" class="btn btn-primary">Envoyer la demande</button>
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('requestDeleteModal').style.display='none'">Annuler</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Polling script ────────────────────────────────────────────────── -->
    <script>
      (function () {
        const depId    = '<%= deployment.id %>';
        const cluster  = '<%= deployment.targetCluster || "gcp" %>';
        const status0  = '<%= deployment.onboardingStatus %>';
        const hasUrl   = !!('<%= cloudRunUrl %>');
        const concl0   = '<%= latest ? (latest.conclusion || "") : "" %>';
        const terminal = concl0 === 'success' || concl0 === 'failure' || concl0 === 'cancelled';

        // Nothing left to poll: URL shown and pipeline is done.
        if (hasUrl && terminal) return;
        // Nothing left to poll: non-GCP terminal failure.
        if (terminal && concl0 !== 'success' && cluster !== 'gcp') return;

        function showUrl(url) {
          const card = document.getElementById('url-card');
          if (!card) return;
          card.style.borderLeft = '4px solid var(--success, #10b981)';
          card.querySelector('.card-header .card-title').textContent = 'Application disponible';
          document.getElementById('url-card-body').innerHTML =
            '<a href="' + url + '" target="_blank" rel="noreferrer" class="btn btn-primary">Ouvrir l\'application ↗</a>' +
            '<span style="font-family:monospace;font-size:13px;color:var(--text-muted);">' + url + '</span>';
        }

        function showTimeout() {
          const body = document.getElementById('url-card-body');
          if (!body) return;
          const spinner = document.getElementById('url-card-spinner');
          if (spinner) spinner.remove();
          document.getElementById('url-card-msg').textContent =
            'URL non disponible après 3 min — vérifiez le statut Crossplane sur le cluster.';
        }

        // GCP URL-waiting timeout: 3 minutes (180 000 ms).
        const URL_TIMEOUT_MS = 180000;
        const urlWaitStart = Date.now();

        const timer = setInterval(async () => {
          try {
            const resp = await fetch('/deployments/' + depId + '/status');
            if (!resp.ok) return;
            const data = await resp.json();

            // Still configuring platform — keep waiting.
            if (data.phase === 'configuring') return;

            // CI running or queued — keep waiting.
            if (data.phase === 'running' || data.phase === 'waiting') {
              // If we were showing the configuring card, reload once to get the runs UI.
              if (status0 === 'configuring') { clearInterval(timer); window.location.reload(); }
              return;
            }

            // CI done — check for Cloud Run URL.
            if (data.phase === 'success' || data.phase === 'failed') {
              if (cluster === 'gcp') {
                if (data.cloudRunUrl) {
                  clearInterval(timer);
                  showUrl(data.cloudRunUrl);
                  return;
                }
                // URL not yet available — keep polling up to the timeout.
                if (Date.now() - urlWaitStart > URL_TIMEOUT_MS) {
                  clearInterval(timer);
                  showTimeout();
                }
                return;
              }
              // Non-GCP: reload to show final state.
              clearInterval(timer);
              window.location.reload();
            }
          } catch (_) {}
        }, 5000);
      })();
    </script>

    <script>
      function switchTab(name) {
        document.getElementById('tab-pipeline').style.display = name === 'pipeline' ? '' : 'none';
        document.getElementById('tab-observability').style.display = name === 'observability' ? '' : 'none';
        ['pipeline', 'observability'].forEach(function(t) {
          var btn = document.getElementById('tab-btn-' + t);
          var active = t === name;
          btn.style.color = active ? 'var(--primary)' : 'var(--text-muted)';
          btn.style.borderBottomColor = active ? 'var(--primary)' : 'transparent';
          btn.style.fontWeight = active ? '600' : '400';
        });
      }
    </script>

  </body>
</html>
