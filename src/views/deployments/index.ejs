<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>

  <body>
    <div class="layout">
      <%- include('../partials/sidebar') %>
        <main class="main-content">
          <div class="content-wrapper">
            <%- include('../partials/flash') %>

              <div class="page-header">
                <div>
                  <div class="page-title">Déploiements</div>
                  <div class="page-subtitle">Gestion des applications déployées sur les clouds CNP</div>
                </div>
                <button id="openNewDeployment" class="btn btn-primary">+ Nouveau déploiement</button>
              </div>

              <!-- Team filter -->
              <% if (allTeams.length > 0) { %>
              <form method="GET" action="/deployments" style="display:flex;align-items:center;gap:10px;margin-bottom:16px;">
                <label style="font-size:13px;color:var(--text-muted);white-space:nowrap;">Filtrer par équipe :</label>
                <select name="team" onchange="this.form.submit()" style="max-width:220px;">
                  <option value="">Toutes les équipes</option>
                  <% allTeams.forEach(t => { %>
                  <option value="<%= t.id %>" <%= filterTeam === t.id ? 'selected' : '' %>><%= t.name %></option>
                  <% }) %>
                </select>
                <% if (filterTeam) { %>
                <a href="/deployments" class="btn btn-ghost btn-sm">Effacer</a>
                <% } %>
              </form>
              <% } %>

              <div class="card">
                <div class="card-header">
                  <span class="card-title">Applications déployées</span>
                  <span class="badge badge-gray">
                    <%= deployments.length %> apps
                  </span>
                </div>
                <div class="table-container">
                  <table>
                    <thead>
                      <tr>
                        <th>Application</th>
                        <th>Équipe</th>
                        <th>Repository</th>
                        <th>Statut</th>
                        <th>Dernier tag</th>
                        <th>Dernière exécution</th>
                        <th>Branche</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% deployments.forEach(dep=> { %>
                        <tr>
                          <td><strong><a href="/deployments/<%= dep.id %>">
                                <%= dep.appName %>
                              </a></strong>
                              <span class="badge badge-gray"><%= dep.environment === 'legacy' ? 'Historique' : dep.environment %></span>
                            </td>
                          <td>
                            <% if (dep.ownerTeam) { %>
                              <a href="/deployments?team=<%= dep.ownerTeam.id %>" class="badge badge-gray" style="text-decoration:none;"><%= dep.ownerTeam.name %></a>
                            <% } else { %>
                              <span style="color:var(--text-muted);font-size:12px;">—</span>
                            <% } %>
                          </td>
                          <td class="font-mono"><a href="<%= dep.githubRepoUrl %>" target="_blank" rel="noreferrer">
                              <%= dep.githubRepoUrl %>
                            </a></td>
                          <td><span class="badge <%= dep.status.badge %>">
                              <%= dep.status.label %>
                            </span></td>
                          <td class="font-mono">
                            <%= dep.deployedTag || '-' %>
                          </td>
                          <td class="text-muted">
                            <%= dep.lastRunTime ? new Date(dep.lastRunTime).toLocaleString('fr-FR') : '-' %>
                          </td>
                          <td>
                            <%= dep.branch || 'main' %>
                          </td>
                          <td>
                            <div class="actions-cell">
                              <% if (can('deployments:delete')) { %>
                                <% if (dep.pendingDeletion) { %>
                                  <span class="badge badge-warning" style="margin-right:6px;">Suppression demandée</span>
                                  <button class="btn btn-danger btn-sm" onclick="openApproveModal('<%= dep.id %>', '<%= dep.appName %>', <%= dep.persistentStorage ? 'true' : 'false' %>, '<%= dep.environment %>')">Approuver</button>
                                  <form action="/deployments/<%= dep.id %>/reject-delete" method="POST" class="inline-form">
                                    <button type="submit" class="btn btn-secondary btn-sm">Refuser</button>
                                  </form>
                                <% } else { %>
                                  <button class="btn btn-danger btn-sm" onclick="openDeleteModal('<%= dep.id %>', '<%= dep.appName %>', <%= dep.persistentStorage ? 'true' : 'false' %>, '<%= dep.environment %>')">Supprimer</button>
                                <% } %>
                              <% } else if (can('deployments:delete:request')) { %>
                                <% if (dep.pendingDeletion) { %>
                                  <span class="badge badge-warning">Demande en attente</span>
                                <% } else { %>
                                  <button class="btn btn-secondary btn-sm" onclick="openRequestModal('<%= dep.id %>', '<%= dep.appName %>', '<%= dep.environment %>')">Demander suppression</button>
                                <% } %>
                              <% } %>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                          <% if (deployments.length===0) { %>
                            <tr>
                              <td colspan="8" style="text-align:center;color:var(--text-muted);padding:32px;">Aucun
                                déploiement</td>
                            </tr>
                            <% } %>
                    </tbody>
                  </table>
                </div>
              </div>

              <!-- Nouveau déploiement modal -->
              <div id="newDeploymentModal"
                style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:999;align-items:center;justify-content:center;">
                <div
                  style="background:var(--surface);width:600px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
                    <h3 style="margin:0;">Nouveau déploiement</h3>
                    <button id="closeNewDeployment" class="btn btn-ghost">Fermer</button>
                  </div>

                  <div style="background:var(--surface-alt,#f8f9fa);border-radius:6px;padding:12px;margin-bottom:16px;font-size:13px;color:var(--text-muted);">
                    La plateforme configure automatiquement le pipeline CI/CD, les secrets GitHub et les manifests
                    Kubernetes. Vous n'avez rien d'autre à faire.
                  </div>

                  <form action="/deployments" method="POST">
                    <div class="form-group">
                      <label for="githubRepoUrl">URL du dépôt GitHub</label>
                      <input type="url" name="githubRepoUrl" id="githubRepoUrl"
                        placeholder="https://github.com/org/mon-app" required
                        oninput="suggestAppName(this.value)">
                      <div class="form-hint">Le dépôt doit être accessible par la GitHub App CNP.</div>
                    </div>

                    <div class="form-group">
                      <label for="appName">Nom de l'application</label>
                      <input type="text" name="appName" id="appName"
                        placeholder="mon-app" required
                        pattern="[a-z0-9][a-z0-9\-]*[a-z0-9]"
                        title="Minuscules, chiffres et tirets uniquement">
                      <div class="form-hint">Minuscules et tirets uniquement (ex: mon-app). Réutilisez ce nom pour les environnements dev et prod du même dépôt.</div>
                    </div>

                    <div class="form-group">
                      <label for="environment">Environnement</label>
                      <select name="environment" id="environment" required>
                        <option value="dev">Développement — automatique depuis main</option>
                        <option value="prod">Production — depuis prod, après validation manager</option>
                      </select>
                      <div class="form-hint">Chaque environnement possède son service et ses données. La production attend l'approbation d'un manager dans le portail.</div>
                      <div class="form-hint">Adresse : &lt;application&gt;.dev.<%= applicationsBaseDomain %> en dev ; &lt;application&gt;.<%= applicationsBaseDomain %> en production.</div>
                    </div>

                    <div class="form-group">
                      <label for="appPort">Port applicatif</label>
                      <input type="number" name="appPort" id="appPort" min="1" max="65535" value="8080" required>
                      <div class="form-hint">Le port que votre application écoute (doit correspondre à EXPOSE dans le Dockerfile).</div>
                    </div>

                    <% if (userTeams.length > 0) { %>
                    <div class="form-group">
                      <label for="ownerTeamId">Équipe propriétaire</label>
                      <select name="ownerTeamId" id="ownerTeamId">
                        <option value="">— Aucune équipe —</option>
                        <% userTeams.forEach(t => { %>
                        <option value="<%= t.id %>" <%= userTeams.length === 1 ? 'selected' : '' %>><%= t.name %></option>
                        <% }) %>
                      </select>
                      <div class="form-hint">L'équipe qui possède ce déploiement. Les membres de l'équipe pourront le voir.</div>
                    </div>
                    <% } %>

                    <div class="form-group">
                      <label for="targetCluster">Cloud cible</label>
                      <select name="targetCluster" id="targetCluster" onchange="onCloudChange(this.value)">
                        <option value="gcp" selected>GCP — Google Cloud Platform (Cloud Run)</option>
                        <option value="aws">AWS — Amazon Web Services</option>
                        <option value="azure">Azure — Souveraineté UE (Container Apps + PostgreSQL)</option>
                      </select>
                      <div class="form-hint">Plateforme de déploiement de l'application.</div>
                      <div id="cloudWarning" role="alert" style="display:none;background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.4);border-radius:6px;padding:10px 12px;margin-top:8px;font-size:13px;color:var(--text-primary);">
                        <strong style="color:#ca8a04;">⚠ Cloud pas encore disponible</strong><br>
                        Le déploiement sur <strong id="cloudWarningName"></strong> n'est pas encore pris en charge. Nos collaborateurs travailleront dessus plus tard. Seuls GCP et Azure sont utilisables pour le moment.
                      </div>
                    </div>

                    <div class="form-group">
                      <label style="display:flex;align-items:center;gap:.6rem;cursor:pointer;font-weight:500;">
                        <input type="checkbox" name="persistentStorage" id="persistentStorage" style="width:18px;height:18px;accent-color:#6366f1;">
                        DB persistante (SQLite sur GCS)
                      </label>
                      <div class="form-hint">Monte un bucket GCS sur <code>/data</code> — les données survivent aux redémarrages. Le bucket est créé automatiquement par la plateforme.</div>
                    </div>

                    <div style="display:flex;gap:10px;margin-top:16px;">
                      <button type="submit" id="deploySubmitBtn" class="btn btn-primary">Déployer</button>
                      <button type="button" id="cancelNewDeployment" class="btn btn-secondary">Annuler</button>
                    </div>
                  </form>
                </div>
              </div>

              <!-- Delete confirmation modal (manager) -->
              <div id="deleteModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
                <div style="background:var(--surface);width:520px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
                  <h3 style="margin:0 0 8px;">Supprimer l'application</h3>
                  <p id="deleteModalText" style="color:var(--text-muted);margin-bottom:16px;"></p>
                  <div class="flash flash-error" style="margin-bottom:16px;font-size:13px;">
                    <span id="deleteCleanupDescription">Cette action supprime les ressources de la cible sélectionnée.</span>
                  </div>
                  <div id="deleteBucketWarning" style="display:none;background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.4);border-radius:6px;padding:12px 14px;margin-bottom:16px;font-size:13px;color:var(--text-primary);">
                    <strong style="color:#ca8a04;">⚠ Bucket GCS avec données potentielles</strong><br>
                    Le stockage persistant de ce déploiement utilise <code style="font-family:monospace;background:rgba(0,0,0,.15);padding:1px 4px;border-radius:3px;">forceDestroy: false</code>.<br>
                    S'il contient des données, GCP refusera la suppression et Crossplane remontera une erreur — le bucket restera dans GCP.<br>
                    <strong>Videz le bucket manuellement avant de continuer.</strong>
                  </div>
                  <form id="deleteForm" method="POST">
                    <div style="margin-bottom:14px;">
                      <label style="font-size:13px;display:block;margin-bottom:6px;">Pour confirmer, saisissez <strong style="font-family:monospace;color:var(--danger,#ef4444);">DELETE</strong> :</label>
                      <input type="text" id="deleteConfirmText" autocomplete="off" placeholder="DELETE"
                        style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-family:monospace;font-size:14px;background:var(--surface);color:var(--text);"
                        oninput="checkDeleteInput()">
                    </div>
                    <div id="deleteBucketAck" style="display:none;margin-bottom:14px;">
                      <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;font-size:13px;">
                        <input type="checkbox" id="deleteBucketAckCheck" style="margin-top:2px;accent-color:var(--danger);">
                        J'ai compris — le bucket est vide ou je suis prêt à le gérer manuellement.
                      </label>
                    </div>
                    <div style="display:flex;gap:10px;">
                      <button type="submit" id="deleteConfirmBtn" class="btn btn-danger" disabled>Confirmer la suppression</button>
                      <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Annuler</button>
                    </div>
                  </form>
                </div>
              </div>

              <!-- Approve deletion request modal (manager) -->
              <div id="approveModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
                <div style="background:var(--surface);width:520px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
                  <h3 style="margin:0 0 8px;">Approuver la demande de suppression</h3>
                  <p id="approveModalText" style="color:var(--text-muted);margin-bottom:16px;"></p>
                  <div class="flash flash-error" style="margin-bottom:16px;font-size:13px;">
                    <span id="approveCleanupDescription">Cela supprimera les ressources de la cible sélectionnée.</span>
                  </div>
                  <div id="approveBucketWarning" style="display:none;background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.4);border-radius:6px;padding:12px 14px;margin-bottom:16px;font-size:13px;color:var(--text-primary);">
                    <strong style="color:#ca8a04;">⚠ Bucket GCS avec données potentielles</strong><br>
                    Le stockage persistant de ce déploiement utilise <code style="font-family:monospace;background:rgba(0,0,0,.15);padding:1px 4px;border-radius:3px;">forceDestroy: false</code>.<br>
                    S'il contient des données, GCP refusera la suppression et Crossplane remontera une erreur — le bucket restera dans GCP.<br>
                    <strong>Videz le bucket manuellement avant de continuer.</strong>
                  </div>
                  <form id="approveForm" method="POST">
                    <div style="margin-bottom:14px;">
                      <label style="font-size:13px;display:block;margin-bottom:6px;">Pour confirmer, saisissez <strong style="font-family:monospace;color:var(--danger,#ef4444);">DELETE</strong> :</label>
                      <input type="text" id="approveConfirmText" autocomplete="off" placeholder="DELETE"
                        style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-family:monospace;font-size:14px;background:var(--surface);color:var(--text);"
                        oninput="checkApproveInput()">
                    </div>
                    <div id="approveBucketAck" style="display:none;margin-bottom:14px;">
                      <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;font-size:13px;">
                        <input type="checkbox" id="approveBucketAckCheck" style="margin-top:2px;accent-color:var(--danger);">
                        J'ai compris — le bucket est vide ou je suis prêt à le gérer manuellement.
                      </label>
                    </div>
                    <div style="display:flex;gap:10px;">
                      <button type="submit" id="approveConfirmBtn" class="btn btn-danger" disabled>Confirmer et supprimer</button>
                      <button type="button" class="btn btn-secondary" onclick="closeApproveModal()">Annuler</button>
                    </div>
                  </form>
                </div>
              </div>

              <!-- Request deletion modal (dev/devops) -->
              <div id="requestModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;align-items:center;justify-content:center;">
                <div style="background:var(--surface);width:480px;border-radius:8px;padding:24px;box-shadow:var(--shadow);">
                  <h3 style="margin:0 0 8px;">Demander la suppression</h3>
                  <p id="requestModalText" style="color:var(--text-muted);margin-bottom:16px;"></p>
                  <form id="requestForm" method="POST">
                    <div class="form-group">
                      <label for="requestReason">Raison (optionnel)</label>
                      <textarea name="reason" id="requestReason" rows="3" style="width:100%;resize:vertical;" placeholder="Expliquez pourquoi cette application doit être supprimée..."></textarea>
                    </div>
                    <div style="display:flex;gap:10px;margin-top:12px;">
                      <button type="submit" class="btn btn-primary">Envoyer la demande</button>
                      <button type="button" class="btn btn-secondary" onclick="closeRequestModal()">Annuler</button>
                    </div>
                  </form>
                </div>
              </div>

              <script>
                const openBtn = document.getElementById('openNewDeployment');
                const modal = document.getElementById('newDeploymentModal');
                const closeBtn = document.getElementById('closeNewDeployment');
                const cancelBtn = document.getElementById('cancelNewDeployment');
                function showModal() { modal.style.display = 'flex'; }
                function hideModal() { modal.style.display = 'none'; }
                if (openBtn) openBtn.addEventListener('click', showModal);
                if (closeBtn) closeBtn.addEventListener('click', hideModal);
                if (cancelBtn) cancelBtn.addEventListener('click', hideModal);

                // Cloud selector: GCP and Azure are supported, AWS shows a warning.
                const CLOUD_LABELS = { aws: 'AWS', azure: 'Azure' };
                function onCloudChange(value) {
                  const unsupported = value !== 'gcp' && value !== 'azure';
                  // Azure stocke ses données dans PostgreSQL : l'option SQLite sur GCS ne s'applique pas.
                  const storage = document.getElementById('persistentStorage');
                  storage.disabled = value === 'azure';
                  if (value === 'azure') storage.checked = false;
                  storage.closest('.form-group').style.opacity = value === 'azure' ? '.5' : '';
                  document.getElementById('cloudWarning').style.display = unsupported ? 'block' : 'none';
                  document.getElementById('cloudWarningName').textContent = CLOUD_LABELS[value] || value;
                  const btn = document.getElementById('deploySubmitBtn');
                  btn.disabled = unsupported;
                  btn.style.opacity = unsupported ? '.5' : '';
                  btn.style.cursor = unsupported ? 'not-allowed' : '';
                }

                // Auto-suggest app name from repo URL
                function suggestAppName(url) {
                  const appNameInput = document.getElementById('appName');
                  if (appNameInput.dataset.userEdited) return;
                  try {
                    const u = new URL(url);
                    const parts = u.pathname.replace(/^\/+|\/+$/g, '').split('/');
                    if (parts.length >= 2) {
                      const repo = parts[1].replace(/\.git$/, '').toLowerCase().replace(/[^a-z0-9-]/g, '-');
                      appNameInput.value = repo;
                    }
                  } catch (_) {}
                }
                document.getElementById('appName').addEventListener('input', function() {
                  this.dataset.userEdited = '1';
                });

                // Delete modal (manager)
                function checkDeleteInput() {
                  const txt = document.getElementById('deleteConfirmText').value;
                  const chk = document.getElementById('deleteBucketAckCheck');
                  const hasBucket = document.getElementById('deleteBucketAck').style.display !== 'none';
                  const bucketOk = !hasBucket || chk.checked;
                  document.getElementById('deleteConfirmBtn').disabled = !(txt === 'DELETE' && bucketOk);
                }
                function openDeleteModal(id, name, hasBucket, environment = 'legacy') {
                  document.getElementById('deleteModalText').textContent = environment === 'legacy'
                    ? `Supprimer "${name}" et toutes ses ressources ?`
                    : `Supprimer l'environnement ${environment} de "${name}" ?`;
                  document.getElementById('deleteCleanupDescription').textContent = environment === 'legacy'
                    ? 'Les manifests, le pipeline CI/CD et les secrets GitHub de cette application seront supprimés.'
                    : "Les ressources de cet environnement seront supprimées. L'autre environnement, le pipeline et les secrets partagés seront conservés.";
                  document.getElementById('deleteForm').action = `/deployments/${id}/delete`;
                  const warn = document.getElementById('deleteBucketWarning');
                  const ack  = document.getElementById('deleteBucketAck');
                  const btn  = document.getElementById('deleteConfirmBtn');
                  const chk  = document.getElementById('deleteBucketAckCheck');
                  const inp  = document.getElementById('deleteConfirmText');
                  inp.value = '';
                  btn.disabled = true;
                  if (hasBucket) {
                    warn.style.display = 'block';
                    ack.style.display  = 'block';
                    chk.checked = false;
                    chk.onchange = checkDeleteInput;
                  } else {
                    warn.style.display = 'none';
                    ack.style.display  = 'none';
                  }
                  document.getElementById('deleteModal').style.display = 'flex';
                  inp.focus();
                }
                function closeDeleteModal() { document.getElementById('deleteModal').style.display = 'none'; }

                // Approve modal (manager)
                function checkApproveInput() {
                  const txt = document.getElementById('approveConfirmText').value;
                  const chk = document.getElementById('approveBucketAckCheck');
                  const hasBucket = document.getElementById('approveBucketAck').style.display !== 'none';
                  const bucketOk = !hasBucket || chk.checked;
                  document.getElementById('approveConfirmBtn').disabled = !(txt === 'DELETE' && bucketOk);
                }
                function openApproveModal(id, name, hasBucket, environment = 'legacy') {
                  document.getElementById('approveModalText').textContent = environment === 'legacy'
                    ? `Approuver la suppression de "${name}" ?`
                    : `Approuver la suppression de l'environnement ${environment} de "${name}" ?`;
                  document.getElementById('approveCleanupDescription').textContent = environment === 'legacy'
                    ? 'Cela supprimera cette application et toutes ses ressources.'
                    : "Cela supprimera uniquement cet environnement. L'autre environnement et le pipeline partagé seront conservés.";
                  document.getElementById('approveForm').action = `/deployments/${id}/approve-delete`;
                  const warn = document.getElementById('approveBucketWarning');
                  const ack  = document.getElementById('approveBucketAck');
                  const btn  = document.getElementById('approveConfirmBtn');
                  const chk  = document.getElementById('approveBucketAckCheck');
                  const inp  = document.getElementById('approveConfirmText');
                  inp.value = '';
                  btn.disabled = true;
                  if (hasBucket) {
                    warn.style.display = 'block';
                    ack.style.display  = 'block';
                    chk.checked = false;
                    chk.onchange = checkApproveInput;
                  } else {
                    warn.style.display = 'none';
                    ack.style.display  = 'none';
                  }
                  document.getElementById('approveModal').style.display = 'flex';
                  inp.focus();
                }
                function closeApproveModal() { document.getElementById('approveModal').style.display = 'none'; }

                // Request modal (dev/devops)
                function openRequestModal(id, name, environment = 'legacy') {
                  if (environment !== 'legacy') name = `${name} (${environment})`;
                  document.getElementById('requestModalText').textContent = `Demander la suppression de "${name}" à un manager.`;
                  document.getElementById('requestForm').action = `/deployments/${id}/request-delete`;
                  document.getElementById('requestModal').style.display = 'flex';
                }
                function closeRequestModal() { document.getElementById('requestModal').style.display = 'none'; }
              </script>

          </div>
        </main>
    </div>
  </body>

</html>
