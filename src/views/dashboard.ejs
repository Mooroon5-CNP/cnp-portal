<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { title: title }) %>

  <body>
    <div class="layout">
      <%- include('partials/sidebar') %>
        <main class="main-content">
          <div class="content-wrapper">
            <%- include('partials/flash') %>

              <div class="page-header">
                <div>
                  <div class="page-title">Dashboard</div>
                  <div class="page-subtitle">Bienvenue, <%= user.username %> — vue d'ensemble de votre équipe
                  </div>
                </div>
              </div>

              <div class="stats-grid">
                <div class="stat-card">
                  <div class="stat-label">Alertes actives</div>
                  <div class="stat-value"
                    style="color: <%= stats.activeAlerts > 0 ? 'var(--danger)' : 'var(--success)' %>">
                    <%= stats.activeAlerts %>
                  </div>
                  <div class="stat-meta">Datadog alerts</div>
                </div>
                <div class="stat-card">
                  <div class="stat-label">Apps ArgoCD</div>
                  <div class="stat-value">
                    <%= stats.syncedApps %>
                  </div>
                  <div class="stat-meta">
                    <%= stats.totalApps %> apps gérées
                  </div>
                </div>
              </div>

              <div class="grid-2">
                <!-- Mes Applications -->
                <div class="card">
                  <div class="card-header">
                    <span class="card-title">Mes Applications</span>
                    <a href="/deployments" class="btn btn-ghost btn-sm">Voir tout</a>
                  </div>
                  <div class="card-body">
                    <% if (myAppsList.length === 0) { %>
                      <div style="text-align:center;padding:20px;color:var(--text-muted);">
                        <div style="font-size:24px;margin-bottom:8px;">📦</div>
                        Aucune application déployée
                      </div>
                    <% } else { %>
                      <% myAppsList.forEach(app => { %>
                        <div style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);">
                          <% if (app.status === 'ready') { %>
                            <span class="badge badge-success" title="Opérationnel">●</span>
                          <% } else if (app.status === 'configuring') { %>
                            <span class="badge badge-warning" title="En cours">●</span>
                          <% } else { %>
                            <span class="badge badge-danger" title="Erreur">●</span>
                          <% } %>
                          <div style="flex:1;min-width:0;">
                            <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                              <%= app.name %>
                            </div>
                            <div style="font-size:12px;color:var(--text-muted);">
                              <% if (app.isGcp) { %>
                                <%= app.url ? 'Cloud Run — actif' : (app.status === 'ready' ? 'Cloud Run — URL en attente' : 'Cloud Run — provisionnement') %>
                              <% } else { %>
                                <%= app.status %>
                              <% } %>
                            </div>
                          </div>
                          <div style="display:flex;gap:6px;flex-shrink:0;">
                            <% if (app.url) { %>
                              <a href="<%= app.url %>" target="_blank" rel="noreferrer" class="btn btn-ghost btn-sm" style="font-size:11px;">↗</a>
                            <% } %>
                          </div>
                        </div>
                      <% }) %>
                    <% } %>
                  </div>
                </div>

                <!-- Alertes récentes -->
                <div class="card">
                  <div class="card-header">
                    <span class="card-title">Alertes récentes</span>
                    <a href="/observability/alerts" class="btn btn-ghost btn-sm">Voir tout</a>
                  </div>
                  <div class="card-body">
                    <% if (recentAlerts.length===0) { %>
                      <div style="text-align:center; padding:20px; color:var(--text-muted);">
                        <div style="font-size:24px;margin-bottom:8px;">✓</div>
                        Aucune alerte active
                      </div>
                      <% } else { %>
                        <% recentAlerts.forEach(alert=> { %>
                          <div
                            style="display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);">
                            <% if (alert.status==='ALERT' ) { %>
                              <span class="badge badge-danger">
                                <%= alert.status %>
                              </span>
                              <% } else { %>
                                <span class="badge badge-warning">
                                  <%= alert.status %>
                                </span>
                                <% } %>
                                  <div style="flex:1;">
                                    <div style="font-weight:600;font-size:13px;">
                                      <%= alert.name %>
                                    </div>
                                    <div style="font-size:12px;color:var(--text-muted);">Service: <%= alert.app %>
                                    </div>
                                  </div>
                                  <% if (alert.silenced) { %>
                                    <span class="badge badge-gray">Silencé</span>
                                    <% } %>
                          </div>
                          <% }) %>
                            <% } %>
                  </div>
                </div>
              </div>

          </div>
        </main>
    </div>
  </body>

</html>
