<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: title }) %>
<body>
<div class="layout">
  <%- include('../partials/sidebar') %>
  <main class="main-content">
    <div class="content-wrapper">
      <%- include('../partials/flash') %>

      <div class="page-header">
        <div>
          <div class="page-title">Documentation</div>
          <div class="page-subtitle">Fichiers locaux depuis /documentation</div>
        </div>
      </div>

      <div class="doc-layout">
        <div class="doc-sidebar">
          <% if (files.length === 0) { %>
            <div style="padding:16px;color:var(--text-muted);font-size:13px;">Aucun fichier .md trouvé</div>
          <% } else { %>
            <%
              // Folders open when they contain the current document (native <details>: this page runs no script).
              const docLink = (file) => {
                const devopsOnly = typeof isDevopsFile === 'function' && isDevopsFile(file);
                const label = file.split('/').pop().replace(/\.md$/, '').replace(/_/g, ' ');
            %>
              <a href="/docs/<%= file %>" class="<%= locals.currentFile === file ? 'active' : '' %>" title="<%= file %>" style="display:flex;align-items:center;justify-content:space-between;gap:6px;">
                <span>📄 <%= label %></span>
                <% if (devopsOnly) { %><span style="font-size:10px;padding:1px 5px;border-radius:3px;background:var(--primary);color:#fff;flex-shrink:0;">DevOps</span><% } %>
              </a>
            <%
              };
              const docFolder = (folder) => {
                const open = typeof locals.currentFile === 'string' && locals.currentFile.startsWith(folder.path + '/');
            %>
              <details class="doc-folder"<%= open ? ' open' : '' %>>
                <summary>📁 <%= folder.name.replace(/_/g, ' ') %></summary>
                <div class="doc-folder-items">
                  <% folder.folders.forEach(docFolder) %>
                  <% folder.files.forEach(docLink) %>
                </div>
              </details>
            <%
              };
            %>
            <% tree.files.forEach(docLink) %>
            <% tree.folders.forEach(docFolder) %>
          <% } %>
        </div>

        <div class="doc-content">
          <% if (!content) { %>
            <div style="color:var(--text-muted);text-align:center;padding:60px 0;">
              <div style="font-size:48px;margin-bottom:16px;">📄</div>
              <div style="font-size:16px;font-weight:600;margin-bottom:8px;">Sélectionnez un fichier</div>
              <div style="font-size:14px;">Choisissez un document dans la liste à gauche</div>
            </div>
          <% } else { %>
            <%- content %>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>
</body>
</html>
