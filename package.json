{
  "name": "cnp-portal",
  "version": "1.0.0",
  "description": "CNP Portal - Cloud Native Platform management interface",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint src test --ext .js",
    "test": "jest --forceExit"
  },
  "dependencies": {
    "@kubernetes/client-node": "^0.20.0",
