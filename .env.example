# ─────────────────────────────────────────────────────────────
# CNP Portal — Environment Variables
# Copy this file to .env and fill in the values.
# .env is NEVER committed. This file is.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO

# ── Session ──────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production

# ── MCP chat (read-only) ─────────────────────────────────────
# Use fake for UI fixtures, http to connect MCP-CNP.
MCP_CLIENT_MODE=fake
MCP_URL=
MCP_TOKEN=
MCP_ORIGIN=http://localhost:3000
MCP_LOCAL_HTTP=false
# Legacy alias; prefer MCP_URL.
MCP_BASE_URL=
MCP_EXPECTED_ORIGIN=http://localhost:3000
MCP_AUDIENCE=cnp-mcp
MCP_CONNECT_TIMEOUT_MS=3000
MCP_TOOL_TIMEOUT_MS=10000
# Shared deployment (Cloud Run MCP): HS256 secret shared with the MCP (Secret Manager cnp-mcp-jwt-secret),
# Cloud Run IAM audience (service URL, without /mcp) and Gemini Cloud Assist call timeout.
MCP_JWT_SECRET=
MCP_IAM_AUDIENCE=
MCP_GCA_TIMEOUT_MS=60000

# Used by the isolated services/platform-api process.
PLATFORM_API_AUDIENCE=cnp-platform-api
PLATFORM_API_SERVICE_TOKEN=

# ── GitHub OAuth (login) ─────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL (dev): http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# ── GitHub App (secret injection into deployed repos) ────────
# Create a GitHub App at https://github.com/organizations/Mooroon5-CNP/settings/apps
# Grant it: Actions read/write (for secrets), Administration read (for public key)
GITHUB_APP_ID=                        # Numeric App ID shown on the App settings page
GITHUB_APP_PRIVATE_KEY=               # Full PEM content — paste multiline as-is
GITHUB_APP_INSTALLATION_ID=           # Installation ID on the Mooroon5-CNP org
GITHUB_CONFIG_REPO_NAME=Mooroon5-CNP/config-repo

# ── ArgoCD ───────────────────────────────────────────────────
# After a GCP migration: follow documentation/Cloud/README.md and run npm run cloud:import.
# Service account token: argocd account generate-token --account <sa>
ARGOCD_SERVER_URL=                    # Internal API URL used by the portal (can be in-cluster)
ARGOCD_UI_URL=                        # Browser-accessible URL shown in the portal to users (e.g. https://argocd.34.x.x.x.nip.io or kubectl port-forward URL)
ARGOCD_TOKEN=
# Alternative managed by Terraform: leave ARGOCD_TOKEN empty when using this login.
ARGOCD_USERNAME=
ARGOCD_PASSWORD=
ARGOCD_INSECURE=false                 # Set true only for self-signed certs in dev
ARGOCD_CA_CERT_BASE64=                # Base64 public CA/certificate trusted for the Argo API; never a private key
# Local Terraform output imports are automatically loaded from .env.cloud.
# CLOUD_ENV_FILE=/absolute/path/to/cloud.env

# ── Datadog ──────────────────────────────────────────────────
DD_API_KEY=                           # Datadog API key (agent + write)
DD_APP_KEY=                           # Datadog Application key (read API)
DD_SITE=datadoghq.com                 # or datadoghq.eu

# Unified Service Tagging (forwarded to the agent DaemonSet)
DD_ENV=dev
DD_SERVICE=cnp-portal
DD_VERSION=1.0.0

# ── Kubernetes / GKE ─────────────────────────────────────────
# Portal service account: apply scripts/cloud/portal-rbac.yaml, including account-provisioning permissions.
KUBE_API_URL=https://xx.xx.xx.xx      # GKE cluster endpoint
KUBE_TOKEN=                           # Service account bearer token
KUBE_CA_CERT=                         # Base64-encoded cluster CA certificate
KUBE_NAMESPACE_PREFIX=                # Optional: filter namespaces by prefix (e.g. cnp-)

# ── Crossplane ───────────────────────────────────────────────
CROSSPLANE_NAMESPACE=crossplane-system

# ── Cluster ingress domain ────────────────────────────────────
# Base domain used to build app URLs (e.g. app-dev.<CLUSTER_BASE_DOMAIN>).
# Without a real domain: set to <INGRESS_EXTERNAL_IP>.nip.io
# Get the IP with: kubectl get svc -n ingress-nginx ingress-nginx-controller -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
CLUSTER_BASE_DOMAIN=cnp.example.com

# Chat routing: local | hybrid (local certain, otherwise Scaleway Mistral) | mistral
MCP_ROUTING_MODE=hybrid
# MCP routing, answer generation and authorized application matching use the
# same Scaleway chat gateway and REPORT_MODEL_API_KEY as voice analysis below.
MCP_MISTRAL_ENABLED=true
# Optional; defaults to VOICE_DEPLOYMENT_ANALYSIS_MODEL, then mistral-small-3.2-24b-instruct-2506.
MCP_MISTRAL_MODEL=
# Assisted deployment: transcription uses whisper-large-v3; set the analysis model separately.
# Configure secrets only in the local .env or the deployment secret manager.
SCW_SECRET_KEY=
# Shared credential for Gateway text analysis and MCP Mistral. Keep only in .env.
REPORT_MODEL_API_KEY=
# Optional: overrides the project ID embedded in the base URL.
SCW_DEFAULT_PROJECT_ID=
VOICE_DEPLOYMENT_GATEWAY_BASE_URL=https://api.scaleway.ai/53dabd61-d11a-46f3-be72-1a992593284f/v1
VOICE_DEPLOYMENT_ANALYSIS_MODEL=
# Optional explicit Argo application mapping, e.g. {"my-app/prod":"my-app-prod"}
MCP_ARGO_APPLICATIONS={}
# Datadog app-scoped metrics already expressed as percentages (0..100).
MCP_CPU_PERCENT_METRIC=
MCP_MEMORY_PERCENT_METRIC=

# Required only for a fresh database or migrating the old admin/admin account.
# Generate a value with: openssl rand -hex 24
ADMIN_INITIAL_PASSWORD=
