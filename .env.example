# GitLab OAuth — inject via K8s Secret cnp-portal-{env}-gitlab-oauth
GITLAB_HOST=https://gitlab.cri.epita.fr
GITLAB_CLIENT_ID=your_gitlab_app_id
GITLAB_CLIENT_SECRET=your_gitlab_app_secret
GITLAB_REDIRECT_URI=https://cnp-portal.example.com/auth/gitlab/callback

# Session — inject via K8s Secret cnp-portal-{env}-session-secret
SESSION_SECRET=change-me-in-production

# Datadog — inject via K8s Secret cnp-portal-{env}-datadog-api-key
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# ArgoCD — inject via K8s Secret cnp-portal-{env}-argocd-token
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO

# Datadog Unified Service Tagging
DD_ENV=dev
DD_SERVICE=cnp-portal
DD_VERSION=1.0.0
