# ─────────────────────────────────────────────────────────────
# CNP Portal — Environment Variables
# Copy this file to .env and fill in the values.
# .env is NEVER committed. This file is.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO

# ── Session ──────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production

# ── GitLab OAuth ─────────────────────────────────────────────
# Create an OAuth App at https://gitlab.cri.epita.fr/-/profile/applications
GITLAB_HOST=https://gitlab.cri.epita.fr
GITLAB_CLIENT_ID=your_gitlab_app_id
GITLAB_CLIENT_SECRET=your_gitlab_app_secret
GITLAB_REDIRECT_URI=https://cnp-portal.example.com/auth/gitlab/callback

# ── GitHub OAuth (login) ─────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Callback URL (dev): http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# ── GitHub App (secret injection into deployed repos) ────────
# Create a GitHub App at https://github.com/organizations/Mooroon5-CNP/settings/apps
# Grant it: Actions read/write (for secrets), Administration read (for public key)
GITHUB_APP_ID=                        # Numeric App ID shown on the App settings page
GITHUB_APP_PRIVATE_KEY=               # Full PEM content — paste multiline as-is
GITHUB_APP_INSTALLATION_ID=           # Installation ID on the Mooroon5-CNP org
GITHUB_CONFIG_REPO_NAME=Mooroon5-CNP/config-repo

# ── ArgoCD ───────────────────────────────────────────────────
# Service account token: argocd account generate-token --account <sa>
ARGOCD_SERVER_URL=https://argocd.cnp.example.com
ARGOCD_TOKEN=
ARGOCD_INSECURE=false                 # Set true only for self-signed certs in dev

# ── Datadog ──────────────────────────────────────────────────
DD_API_KEY=                           # Datadog API key (agent + write)
DD_APP_KEY=                           # Datadog Application key (read API)
DD_SITE=datadoghq.com                 # or datadoghq.eu

# Unified Service Tagging (forwarded to the agent DaemonSet)
DD_ENV=dev
DD_SERVICE=cnp-portal
DD_VERSION=1.0.0

# ── Kubernetes / GKE ─────────────────────────────────────────
# Service account with read-only access (get/list/watch on pods, namespaces, events)
KUBE_API_URL=https://xx.xx.xx.xx      # GKE cluster endpoint
KUBE_TOKEN=                           # Service account bearer token
KUBE_CA_CERT=                         # Base64-encoded cluster CA certificate
KUBE_NAMESPACE_PREFIX=                # Optional: filter namespaces by prefix (e.g. cnp-)

# ── Crossplane ───────────────────────────────────────────────
CROSSPLANE_NAMESPACE=crossplane-system
