FROM python:3.13-slim@sha256:b3575dcf816cdacc5292df77a6e3e59b8941631078373a045efa2ac1e9c5c3b2
WORKDIR /app
COPY requirements.txt requirements.automation.txt ./
RUN pip install --no-cache-dir -r requirements.automation.txt
COPY postgres_contract.py database.py replication_tls.py automation.py ./
RUN chmod 1777 /tmp
VOLUME ["/tmp"]
USER 10001
ENTRYPOINT ["python", "automation.py"]
CMD ["--help"]
